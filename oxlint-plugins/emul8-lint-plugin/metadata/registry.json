      },
      "status": "active",
      "severity": "warn",
      "fixable": true,
      "created": "2025-01-04",
      "linkedPatterns": ["i18n-review:rtl-support:logical-properties"],
      "examples": {
        "valid": ["<div className=\"ms-4\">Content</div>"],
        "invalid": ["<div className=\"ml-4\">Content</div>"]
      }
    },
