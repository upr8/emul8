{
  "$schema": "./schema.json",
  "version": "1.0.0",
  "rules": {
    "no-div-onclick": {
      "name": "no-div-onclick",
      "category": "a11y",
      "description": "Warn when onClick is used on div elements - should use button for accessibility",
      "source": {
        "type": "agent-generated",
        "agent": "a11y-review",
        "author": "claude-opus"
      },
      "status": "active",
      "severity": "warn",
      "fixable": false,
      "created": "2025-01-04",
      "linkedPatterns": ["a11y-review:interactive-elements:div-with-onclick"],
      "examples": {
        "valid": ["<button onClick={handleClick}>Click</button>"],
        "invalid": ["<div onClick={handleClick}>Click</div>"]
      }
    },
    "no-span-onclick": {
      "name": "no-span-onclick",
      "category": "a11y",
      "description": "Warn when onClick is used on span elements without proper ARIA attributes",
      "source": {
        "type": "agent-generated",
        "agent": "a11y-review",
        "author": "claude-opus"
      },
      "status": "active",
      "severity": "warn",
      "fixable": false,
      "created": "2025-01-04",
      "linkedPatterns": ["a11y-review:interactive-elements:span-with-onclick"],
      "examples": {
        "valid": ["<span role=\"button\" tabIndex={0} onClick={handleClick}>Click</span>"],
        "invalid": ["<span onClick={handleClick}>Click</span>"]
      }
    },
    "no-positive-tabindex": {
      "name": "no-positive-tabindex",
      "category": "a11y",
      "description": "Warn against positive tabIndex values which disrupt natural tab order",
      "source": {
        "type": "agent-generated",
        "agent": "a11y-review",
        "author": "claude-opus"
      },
      "status": "active",
      "severity": "warn",
      "fixable": false,
      "created": "2025-01-04",
      "linkedPatterns": ["a11y-review:keyboard-nav:positive-tabindex"],
      "examples": {
        "valid": ["<button tabIndex={0}>Button</button>", "<button tabIndex={-1}>Button</button>"],
        "invalid": ["<button tabIndex={5}>Button</button>"]
      }
    },
    "no-physical-margin": {
      "name": "no-physical-margin",
      "category": "i18n",
      "description": "Use logical margin properties (ms-*, me-*) instead of physical (ml-*, mr-*) for RTL support",
      "source": {
