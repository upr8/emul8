{
  "name": "emul8",
  "version": "0.1.0",
  "description": "Emulate Design Systems",
  "homepage": "https://github.com/upr8/emul8#readme",
  "bugs": {
    "url": "https://github.com/upr8/emul8/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upr8/emul8.git"
  },
  "license": "MIT",
  "author": "upr8",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/styles/globals.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "vitest run --project storybook",
    "typescript:check": "tsc --noEmit",
    "vite:build": "vite build",
    "build": "pnpm typescript:check && pnpm vite:build && pnpm storybook:build",
    "pre-commit": "pnpm format:check && pnpm lint:check && pnpm validate:structure && pnpm unit && pnpm storybook:test",
    "fix": "pnpm format:fix && pnpm lint:fix",
    "lint:check": "oxlint -c oxlint.json src",
    "lint:fix": "oxlint -c oxlint.json src --fix",
    "format:check": "biome check",
    "format:fix": "biome check --write",
    "validate:structure": "tsx scripts/validate-structure.ts",
    "lint:scaffold": "tsx scripts/lint-rule-scaffold.ts",
    "lint:governance": "tsx scripts/lint-governance-report.ts",
    "lint:audit": "tsx scripts/lint-governance-report.ts audit",
    "unit": "vitest run --project unit",
    "unit:watch": "vitest --project unit",
    "unit:coverage": "vitest run --project unit --coverage",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@chromatic-com/storybook": "^4.1.3",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@storybook/addon-a11y": "^10.1.10",
    "@storybook/addon-docs": "^10.1.10",
    "@storybook/addon-vitest": "^10.1.10",
    "@storybook/react-vite": "^10.1.10",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "oxlint": "^1.36.0",
    "playwright": "^1.57.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.1.10",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^4.0.16"
  }
}
