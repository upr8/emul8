        "author": "claude-opus"
      },
      "status": "active",
      "severity": "error",
      "fixable": false,
      "created": "2025-01-04",
      "linkedPatterns": ["performance-review:ssr-safety:window-access"],
      "examples": {
        "valid": ["useEffect(() => { window.scrollTo(0, 0); }, [])"],
        "invalid": ["const width = window.innerWidth;"]
      }
    },
    "no-direct-document": {
