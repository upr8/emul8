/**
 * Extract layer/module from file path
 * @param {string} filePath - The file path to analyze
 * @returns {string|null} The layer/module name or null
 */
function getModuleFromFilePath(filePath) {
  // Customize this based on your project structure
  // Example: Extract layer from /src/{layer}/ComponentName/...
  const match = filePath.match(/[/\\]src[/\\]([^/\\]+)[/\\]/);
  return match ? match[1] : null;
}

/**
 * Extract layer/module from import path
 * @param {string} importPath - The import source path
 * @param {string} currentFilePath - Current file's path for relative resolution
 * @returns {string|null} The layer/module name or null
 */
function getModuleFromImportPath(importPath, currentFilePath) {
  // Handle absolute imports (e.g., @/utils/...)
  const absoluteMatch = importPath.match(/^@\/([^/]+)/);
  if (absoluteMatch) {
    return absoluteMatch[1];
  }

